//c program to print an array

#include<stdio.h>
int main()
{
    int i,n;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    scanf("%d",&arr[i]);
    for(i=0;i<n;i++)
    printf("%d ",arr[i]);
}

//sum of elements in array

#include<stdio.h>
int main()
{
    int i,n,sum=0;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    {scanf("%d",&arr[i]);
    sum=sum+arr[i];
    }
    printf("sum of elements : %d ",sum);
}

// // average of elements in array

#include<stdio.h>
int main()
{
    int i,n,sum=0;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    {scanf("%d",&arr[i]);
    sum=sum+arr[i];
    }
    float average=(float)sum/n;
    printf("average of elements : %.2f",average);
}


// maximum element in array

#include<stdio.h>
int main()
{
    int i,n,maximum;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    scanf("%d",&arr[i]);
    maximum=arr[0];
    for(i=1;i<n;i++)
    {
        if(arr[i]>maximum)
        maximum=arr[i];
    }
    printf("maximum of elements : %d",maximum);
}


//minimum element in array

#include<stdio.h>
int main()
{
    int i,n,minimum;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    scanf("%d",&arr[i]);
    minimum=arr[0];
    for(i=1;i<n;i++)
    {
        if(arr[i]<minimum)
        minimum=arr[i];
    }
    printf("minimum of elements : %d",minimum);
}


// 2D arrays

#include<stdio.h>
int main()
{
    int row,col,i,j;
    scanf("%d%d",&row,&col);
    int arr[row][col];
    for(i=0;i<row;i++)
    {
      for(i=0;i<row;i++)
      scanf("%d",&arr[i][j]);
    }
    printf("output is:\n");
    for(i=0;i<row;i++,printf("\n"))
    {
        for(j=0;j<col;j++)
        printf("%d",arr[i][j]);
    }
}

// to reverse  in array

#include<stdio.h>
int main()
{
    int i,n;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    scanf("%d",&arr[i]);
    for(i=n-1;i>=0;i--)
    printf("%d ",arr[i]);

}

#include<stdio.h>
int main()
{
    int i,n,sum=0,count=0;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    {scanf("%d",&arr[i]);
    if(arr[i]%2==0 && arr[i]%3==0)
    {sum=sum+arr[i];
    count++;}
    
    }
     float average=(float)sum/count;
    printf("average of elements : %.2f",average);
}
