#include<stdio.h>
int main()
{
    int n,row,column;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
      for(column=0;column<2*row-1;column++)
      printf("* ");
    }
}

// COMBINATION OF BASE 2 AND BASE 1
// *****
//  *****
//   *****
//    *****
//     *****


#include<stdio.h>
int main()
{
    int n,row,column;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
      for(column=0;column<=row-1;column++)
      printf(" ");
      for(column=0;column<n;column++)
      printf("*");
    }
}


