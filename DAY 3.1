// *****

#include<stdio.h>
int main()
{
    int n,row,column;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
      for(column=0;column<=row;column++)
      printf("* ");
    }
}

// base 3
// *****
// ****
// ***
// **
// *

#include<stdio.h>
int main()
{
    int n,row,column;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
      for(column=0;column<n-row;column++)
      printf("* ");
    }
}

