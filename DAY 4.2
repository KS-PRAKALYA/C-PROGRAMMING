// to print a string with space 
// I/P      O/P 
// HI HLO   HI HLO 

// IN SCANING WE HAVE TO ADD "%[^\n]s" instead od "%s" 
// "%[^\n]s" it denotes as except enter everything is character.

#include<stdio.h>
int main()
{
    char ch[100];
    scanf("%[^\n]s",ch);
    printf("%s",ch);
}

// to find the length of a string:

#include<stdio.h>
#include<string.h>
int main()
{
    char arr[100];
    scanf("%[^\n]s",arr);
    int len=strlen(arr);
    //here strlen is built-in function.
    printf("%d",len);
}

// to find the length of a string without using in-built function:

#include<stdio.h>
int main()
{
    char arr[100];
    scanf("%[^\n]s",arr);
    int i,count=0;
    for(i=0;arr[i]!='\0';i++)
    count++;
    printf("length of the string is %d",count);
}

// to print number of words in given string

#include<stdio.h>
int main()
{
    char arr[100];
    scanf("%[^\n]s",arr);
    int i,count=0;
    for(i=0;arr[i]!='\0';i++)
    {
        char ch=arr[i];
        if(ch==' ')
        count++;
    }
    printf("number of words in string is %d",count+1);
}

// to print number of vowel letters in given string

#include<stdio.h>
int main()
{
    char arr[100];
    scanf("%[^\n]s",arr);
    int i,count=0;
    for(i=0;arr[i]!='\0';i++)
    {
        char ch=arr[i];
        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'||ch=='A'||ch=='E'||ch=='I'||ch=='O'||ch=='U')
        count++;
    }
    printf("number of vowel letters in string is %d",count);
}

// to change the case of the string 
// using ASCII value

// I/P               O/P 
// pendrIVE          PENDRive

#include<stdio.h>
int main()
{
    char arr[100];
    scanf("%[^\n]s",arr);
    int i;
    for(i=0;arr[i]!='\0';i++)
    {
      char ch=arr[i];
      if(ch>='A' && ch<='Z')
      printf("%c",ch+32);
      else if(ch>='a' && ch<='z')
      printf("%c",ch-32);
      else
      printf("%c",ch);
    }
}

//special occurance of a character
//specified character occuring times
// class      s   2 
//apple       p   2

#include<stdio.h>
int main()
{
    char arr[100];
    printf("enter str:");
    scanf("%s",arr);
    
    int i,count=0;

    char x;
    printf("enter char:");
    scanf(" %c",&x);
    
    for(i=0;arr[i]!='\0';i++)
    {
        char ch=arr[i];
        if(ch==x)
        count++;
    }
    printf("number of times %c occurs  in string is %d",x,count);
}

// to reverse an string

#include<stdio.h>
int main()
{
    char ch[100];
    scanf("%s",ch);
    int i,len=0;
    for(i=0;ch[i]!='\0';i++)
      len++;
    for(i=len-1;i>=0;i--)
    printf("%c",ch[i]);

}



//switch syntax

switch(value/expression/variable)
{
    case value:
    //set of statements;
    break;
    default:
    //set of statements;
}
 
 
// I/P      O/P 
// 1        MONDAY
// 2        TUESDAY
// 3        WEDNESDAY

#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    switch(n)
    {
        case 1:
        printf("sunday");
        break;
        case 2:
        printf("monday");
        break;
        case 3:
        printf("tuesday");
        break;
        case 4:
        printf("wednesday");
        break;
        case 5:
        printf("thursday");
        break;
        case 6:
        printf("friday");
        break;
        case 7:
        printf("saturday");
        break;
        default:
        printf("invalid input");
    }
}


// solve the following
// i/p            o/p 
// A           AIDS
// B           BUSINESS MANAGEMENT
// C           CYBER SECURITY

#include<stdio.h>
int main(){
    char n;
    scanf("%c",&n);
    switch(n)
    {
        case 'A':
        printf("AIDS");
        break;
        case 'B':
        printf("BUSINESS MANAGEMENT");
        break;
        case 'C':
        printf("CYBER SECURITY");
        break;
        default:
        printf("invalid input");
    }
}
        
// to print range in switch 

syntax
case startingrange ... endingrange:

// as
// 0 -34    fail
// 35-60    average
// 61-100   good

#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    switch(n)
    {
        case 0 ... 34:
        printf("FAIL");
        break;
        case 35 ... 60:
        printf("AVERAGE");
        break;
        case 61 ... 100:
        printf("GOOD");
        break;
        default:
        printf("invalid input");
    }
}

// to reverse an string in array

#include<stdio.h>
int main()
{
    int i,n;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    scanf("%d",&arr[i]);
    for(i=n-1;i>=0;i--)
    printf("%d ",arr[i]);

}
