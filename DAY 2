// two numbers are equal or not
// I/P       O/P 
// 2 2     EQUAL 
// 2 4     NOT EQUAL

#include<stdio.h>
int main()
{
    int a,b;
    scanf("%d%d",&a,&b);
    if(a=b)
    printf("equal");
    else
    printf("not equal");
}

// write a c programm to check the number is +ive or -ive or 0
// I/P              O/P 
// 12               NUMBER IS 12 : POSITIVE
// -9               NUMBER IS -9 : NEGATIVE
// 0                NUMBER IS  0 : ZERO

#include<stdio.h>
int main(){
    int a;
    scanf("%d",&a);
    if(a>0)
    printf("number is %d:positive",a);
    else if(a<0)
    printf("number is %d:negative",a);
    else
    printf("number is %d:zero",a);
    
}

