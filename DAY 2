// to find the sum of n numbers
// get starting and ending range from user

#include<stdio.h>
int main()
{
    int i,n,sum=0;
    scanf("%d %d",&i,&n);
    for(i;i<=n;i++)
    sum=sum+i;
    printf("%d",sum);
}


