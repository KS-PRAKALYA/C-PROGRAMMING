// base 1 number printing concepts

// 12345
// 12345
// 12345
// 12345
// 12345

#include<stdio.h>
int main()
{
    int n,row,column;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
      for(column=0;column<n;column++)
      printf("%d",column+1);
    }
}

